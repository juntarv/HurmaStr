# Скопіюйте у .env поряд із docker-compose.yml і заповніть значення.
#   cp .env.docker.example .env

# ОБОВ'ЯЗКОВО. Довгий випадковий секрет для підпису JWT-сесій.
# Згенерувати:  openssl rand -base64 48
AUTH_SECRET=

# Порт на хості (у контейнері завжди 3000)
PORT=3000

# true ЛИШЕ за HTTPS (реверс-проксі з TLS). Для HTTP лишіть false —
# інакше браузер не збереже cookie сесії і вхід не працюватиме.
COOKIE_SECURE=false

# Перший адміністратор (створюється при першому старті). ЗМІНІТЬ пароль після входу.
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=change-me-strong
