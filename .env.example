# База даних (SQLite для розробки)
DATABASE_URL="file:./dev.db"

# Секрет для підпису JWT-сесій — ОБОВ'ЯЗКОВО змініть на проді
AUTH_SECRET="change-me-to-a-long-random-string"

# secure-cookie. Залиште порожнім/false для локальної мережі по HTTP.
# Виставте true ЛИШЕ якщо застосунок працює через HTTPS.
# COOKIE_SECURE=false

# Акаунт адміністратора, який створює `npm run db:seed`
# SEED_ADMIN_EMAIL="admin@hurma.local"
# SEED_ADMIN_PASSWORD="admin12345"

# Демо-персонал (SEED_DEMO=false — не створювати)
# SEED_DEMO=true
